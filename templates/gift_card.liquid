{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <title>Gift Card - {{ shop.name }}</title>
    {{ content_for_header }}
    <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
  </head>
  <body>
    <div class="container" style="padding: 4rem 1rem; text-align: center;">
      <h1 class="section-title">Your Gift Card</h1>
      <p class="section-desc">Value: {{ gift_card.initial_value | money }}</p>
    </div>
  </body>
</html>
