<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <span class="logo-text" style="color: #FFF; font-size: 1.5rem;">{{ shop.name | default: "AURA BOTANICA" }}</span>
        <p class="footer-brand-p">
          {{ section.settings.footer_about | default: "Small-batch botanical skincare hand-formulated with ethically wild-foraged florals, certified cold-pressed seed oils, and bioactive phytonutrients." }}
        </p>
      </div>
      <div>
        <h4 class="footer-col-title">Shop Rituals</h4>
        <ul class="footer-links">
          {% for link in linklists.footer.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. Powered by Shopify.</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_about",
      "label": "About Text",
      "default": "Small-batch botanical skincare hand-formulated with ethically wild-foraged florals."
    }
  ]
}
{% endschema %}
