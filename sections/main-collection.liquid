<div class="container" style="padding: 4rem 1.5rem;">
  <div class="section-header">
    <h1 class="section-title">{{ collection.title | default: 'All Formulations' }}</h1>
    <p class="section-desc">{{ collection.description }}</p>
  </div>
  <div class="products-grid">
    {%- for product in collection.products -%}
      <div class="product-card">
        <div class="product-image-box">
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
        </div>
        <div class="product-info">
          <h3 class="product-name">{{ product.title }}</h3>
          <div class="price-current">{{ product.price | money }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
