<section class="reviews-section" id="reviews">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Real Experiences</span>
      <h2 class="section-title">Loved by Over 20,000 Complexions</h2>
      <p class="section-desc">Unfiltered testimonials from clients who transformed their skin with our natural formulas.</p>
    </div>

    <div class="reviews-grid">
      <div class="review-card">
        <div class="review-card-stars">★★★★★</div>
        <h4 class="review-card-title">"Replaced every luxury serum I owned."</h4>
        <p class="review-card-quote">
          "I used to spend $200+ on French department store serums. The Restorative Serum from Aura Botanica calmed my hormonal flare-ups within a single week. My skin is luminous."
        </p>
        <div class="reviewer-footer">
          <span class="reviewer-info-name">Sophia Montgomery</span>
          <span class="reviewer-verified">✓ Verified Buyer</span>
        </div>
      </div>

      <div class="review-card">
        <div class="review-card-stars">★★★★★</div>
        <h4 class="review-card-title">"The Rosehip Oil is liquid gold."</h4>
        <p class="review-card-quote">
          "Most facial oils sit on top of my face like grease. This sinks right in and leaves the most ethereal, satin finish. The amber bottle and bamboo dropper look stunning on my shelf."
        </p>
        <div class="reviewer-footer">
          <span class="reviewer-info-name">Amara Khan</span>
          <span class="reviewer-verified">✓ Verified Buyer</span>
        </div>
      </div>

      <div class="review-card">
        <div class="review-card-stars">★★★★★</div>
        <h4 class="review-card-title">"The entire 4-step ritual is divine."</h4>
        <p class="review-card-quote">
          "I gifted myself the Radiance Set for my birthday. Smells like real fresh rose fields and herbal gardens, not artificial perfume. My makeup glides on like silk now!"
        </p>
        <div class="reviewer-footer">
          <span class="reviewer-info-name">Claire DeWitt</span>
          <span class="reviewer-verified">✓ Verified Buyer</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": []
}
{% endschema %}
