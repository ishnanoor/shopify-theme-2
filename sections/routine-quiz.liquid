<section class="quiz-section" id="skin-quiz">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Personalized Prescriptions</span>
      <h2 class="section-title">Discover Your Botanical Regimen</h2>
      <p class="section-desc">Take our 45-second skin diagnostic to match your skin goals with certified active botanical pairings.</p>
    </div>

    <div class="quiz-container">
      <div class="quiz-step-progress" id="quiz-step-progress">
        <div class="quiz-progress-bar-bg"></div>
        <div class="quiz-progress-bar-fill" id="quiz-progress-bar"></div>
        <div class="quiz-step-indicator active" id="quiz-indicator-1">1</div>
        <div class="quiz-step-indicator" id="quiz-indicator-2">2</div>
        <div class="quiz-step-indicator" id="quiz-indicator-3">3</div>
      </div>

      <div class="quiz-step" id="quiz-step-1">
        <div class="quiz-question-box">
          <h3 class="quiz-question-title">What is your primary skin type?</h3>
          <p class="quiz-question-sub">This helps us balance moisture weights and active ingredient absorption.</p>
          <div class="quiz-options-grid">
            <div class="quiz-option-card selected" onclick="selectQuizOption(1, 'skinType', 'dry', this)">
              <span class="quiz-option-icon">💧</span>
              <div>
                <div class="quiz-option-title">Dry & Dehydrated</div>
                <div class="quiz-option-desc">Feels tight, shows dry patches, seeks supple dewiness.</div>
              </div>
            </div>
            <div class="quiz-option-card" onclick="selectQuizOption(1, 'skinType', 'combination', this)">
              <span class="quiz-option-icon">⚖️</span>
              <div>
                <div class="quiz-option-title">Combination</div>
                <div class="quiz-option-desc">Oily T-zone with normal to dry cheek areas.</div>
              </div>
            </div>
            <div class="quiz-option-card" onclick="selectQuizOption(1, 'skinType', 'sensitive', this)">
              <span class="quiz-option-icon">🌿</span>
              <div>
                <div class="quiz-option-title">Sensitive & Reactive</div>
                <div class="quiz-option-desc">Prone to redness, stinging, and environmental stress.</div>
              </div>
            </div>
            <div class="quiz-option-card" onclick="selectQuizOption(1, 'skinType', 'oily', this)">
              <span class="quiz-option-icon">✨</span>
              <div>
                <div class="quiz-option-title">Oily & Congested</div>
                <div class="quiz-option-desc">Excess shine, visible pores, prefers lightweight textures.</div>
              </div>
            </div>
          </div>
          <div class="quiz-actions" style="justify-content: flex-end;">
            <button class="btn-primary" onclick="nextQuizStep()">
              <span>Continue</span>
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="quiz-step" id="quiz-step-2" style="display: none;">
        <div class="quiz-question-box">
          <h3 class="quiz-question-title">What is your foremost complexion goal?</h3>
          <p class="quiz-question-sub">Select what you would most love to transform.</p>
          <div class="quiz-options-grid">
            <div class="quiz-option-card selected" onclick="selectQuizOption(2, 'concern', 'glow', this)">
              <span class="quiz-option-icon">🌟</span>
              <div>
                <div class="quiz-option-title">Deep Radiance & Glow</div>
                <div class="quiz-option-desc">Awaken dull, fatigued skin with rich antioxidants.</div>
              </div>
            </div>
            <div class="quiz-option-card" onclick="selectQuizOption(2, 'concern', 'barrier', this)">
              <span class="quiz-option-icon">🛡️</span>
              <div>
                <div class="quiz-option-title">Barrier Repair & Calming</div>
                <div class="quiz-option-desc">Soothe inflammation, reduce redness, and fortify.</div>
              </div>
            </div>
            <div class="quiz-option-card" onclick="selectQuizOption(2, 'concern', 'aging', this)">
              <span class="quiz-option-icon">⏳</span>
              <div>
                <div class="quiz-option-title">Cellular Renewal & Firmness</div>
                <div class="quiz-option-desc">Plump fine lines and restore natural bounce.</div>
              </div>
            </div>
            <div class="quiz-option-card" onclick="selectQuizOption(2, 'concern', 'balance', this)">
              <span class="quiz-option-icon">🍃</span>
              <div>
                <div class="quiz-option-title">Pore Clarity & Balance</div>
                <div class="quiz-option-desc">Refine skin texture without stripping natural oils.</div>
              </div>
            </div>
          </div>
          <div class="quiz-actions">
            <button class="btn-secondary" onclick="prevQuizStep()">Back</button>
            <button class="btn-primary" onclick="nextQuizStep()">
              <span>Continue</span>
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="quiz-step" id="quiz-step-3" style="display: none;">
        <div class="quiz-question-box">
          <h3 class="quiz-question-title">What finish do you desire?</h3>
          <p class="quiz-question-sub">How do you prefer your skincare to feel on your skin?</p>
          <div class="quiz-options-grid">
            <div class="quiz-option-card selected" onclick="selectQuizOption(3, 'texture', 'dewy', this)">
              <span class="quiz-option-icon">💧</span>
              <div>
                <div class="quiz-option-title">Rich, Dewy & Cushioning</div>
                <div class="quiz-option-desc">Decadent hydration that leaves a glass-skin sheen.</div>
              </div>
            </div>
            <div class="quiz-option-card" onclick="selectQuizOption(3, 'texture', 'velvet', this)">
              <span class="quiz-option-icon">☁️</span>
              <div>
                <div class="quiz-option-title">Velvety & Fast Absorbing</div>
                <div class="quiz-option-desc">Instant sink-in feel with zero greasy aftermath.</div>
              </div>
            </div>
          </div>
          <div class="quiz-actions">
            <button class="btn-secondary" onclick="prevQuizStep()">Back</button>
            <button class="btn-primary" onclick="nextQuizStep()">
              <span>Reveal My Custom Routine</span>
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="quiz-result-box" id="quiz-result-box">
        <span class="quiz-result-badge">Custom Formulation Match</span>
        <h3 class="quiz-result-title">Your 3-Step Radiance Protocol</h3>
        <p class="quiz-result-desc">Based on your answers, our herbalists have assembled your ideal morning & evening regimen to rebuild lipid integrity and maximize glow.</p>

        <div class="quiz-recommendations-list" id="quiz-rec-items"></div>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <button class="btn-primary" onclick="addFullQuizRoutineToCart()">
            <span>Add Full Routine to Bag (15% Bundle Discount)</span>
          </button>
          <button class="btn-secondary" onclick="resetQuiz()">Retake Diagnostic</button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Routine Quiz",
  "settings": []
}
{% endschema %}
