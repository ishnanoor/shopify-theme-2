<section class="bundle-feature-section" id="bundle-section">
  <div class="container">
    <div class="bundle-grid">
      <div class="bundle-media-box">
        <img src="{{ 'promo-flatlay.jpg' | asset_url }}" alt="The Complete Radiance Ritual Flatlay Set">
      </div>

      <div class="bundle-content">
        <div class="bundle-pills">
          <span class="bundle-pill">Limited Edition</span>
          <span class="bundle-pill">Save 20%</span>
        </div>
        <h2 class="bundle-title">The Complete Radiance Ritual Set</h2>
        <p class="bundle-desc">
          Experience the harmonious full-spectrum power of the Aura Botanica suite. Carefully sequenced to prep, treat, nourish, and seal your skin barrier with biocompatible florachemistry.
        </p>

        <ul class="bundle-includes-list">
          <li class="bundle-includes-item">
            <span class="bundle-check-icon">✓</span>
            <span><strong>Restorative Botanical Serum (30ml)</strong> — Cell repair & plumping</span>
          </li>
          <li class="bundle-includes-item">
            <span class="bundle-check-icon">✓</span>
            <span><strong>Rose & Rosehip Facial Oil (30ml)</strong> — Lipid nourishment & glow</span>
          </li>
          <li class="bundle-includes-item">
            <span class="bundle-check-icon">✓</span>
            <span><strong>Hydrating Rose Face Cream (50ml)</strong> — 24H moisture barrier seal</span>
          </li>
          <li class="bundle-includes-item">
            <span class="bundle-check-icon">✓</span>
            <span><strong>Balancing Green Tea Face Mist (100ml)</strong> — Antioxidant pH reset</span>
          </li>
          <li class="bundle-includes-item">
            <span class="bundle-check-icon">✓</span>
            <span><strong>Complimentary Organic Canvas Travel Pouch</strong></span>
          </li>
        </ul>

        <div class="bundle-price-cta-box">
          <div class="bundle-price-left">
            <span class="bundle-price-main">$175.00</span>
            <span class="bundle-price-old">$218.00 (Save $43)</span>
          </div>
          <button class="btn-primary" style="flex-grow: 1;" onclick="addToCart('bundle-05')">
            <span>Claim Bundle Ritual</span>
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Spotlight",
  "settings": []
}
{% endschema %}
