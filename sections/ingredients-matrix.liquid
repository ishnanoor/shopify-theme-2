<section class="ingredients-section" id="ingredients">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Source Transparency</span>
      <h2 class="section-title">The Active Botanical Matrix</h2>
      <p class="section-desc">Unadulterated plant biochemistry. We display every component and its biological purpose with total clarity.</p>
    </div>

    <div class="ingredients-grid">
      <div class="ingredient-card">
        <div class="ingredient-icon-box">🌹</div>
        <span class="ingredient-latin">Rosa Damascena</span>
        <h3 class="ingredient-title">Damascus Rose Distillate</h3>
        <p class="ingredient-desc">Steam-distilled petals deliver natural soothing anti-inflammatory polyphenols, locking in cellular water while comforting redness.</p>
      </div>

      <div class="ingredient-card">
        <div class="ingredient-icon-box">🍇</div>
        <span class="ingredient-latin">Rosa Canina Seed</span>
        <h3 class="ingredient-title">Cold-Pressed Rosehip Oil</h3>
        <p class="ingredient-desc">Packed with natural trans-retinoic acid, omegas 3 & 6, and vitamin C to encourage gentle cellular turnover and fade discoloration.</p>
      </div>

      <div class="ingredient-card">
        <div class="ingredient-icon-box">🍵</div>
        <span class="ingredient-latin">Camellia Sinensis</span>
        <h3 class="ingredient-title">Green Tea Polyphenols</h3>
        <p class="ingredient-desc">Harvested in spring shade for maximum EGCG catechins, combating blue light damage and neutralizing free radicals in skin tissue.</p>
      </div>

      <div class="ingredient-card">
        <div class="ingredient-icon-box">🌿</div>
        <span class="ingredient-latin">Biomimetic Squalane</span>
        <h3 class="ingredient-title">Olive-Derived Squalane</h3>
        <p class="ingredient-desc">An identical molecule to human sebum that prevents trans-epidermal water loss and leaves a silk finish without clogging pores.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Matrix",
  "settings": []
}
{% endschema %}
