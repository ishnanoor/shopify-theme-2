<div class="container" style="padding: 5rem 1.5rem; max-width: 800px;">
  <h1 class="section-title" style="text-align: center;">{{ 'cart.title' | t | default: 'Your Shopping Bag' }}</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      <div style="margin: 2rem 0;">
        {% for item in cart.items %}
          <div class="cart-item">
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" class="cart-item-img">
            <div class="cart-item-info">
              <h3 class="cart-item-title">{{ item.product.title }}</h3>
              <div class="cart-item-variant">{{ item.variant.title }}</div>
              <div class="cart-item-price">{{ item.final_line_price | money }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
      <div style="text-align: right;">
        <h3>Subtotal: {{ cart.total_price | money }}</h3>
        <button type="submit" name="checkout" class="btn-primary" style="margin-top: 1rem;">
          {{ 'cart.checkout' | t | default: 'Proceed to Checkout' }}
        </button>
      </div>
    </form>
  {% else %}
    <p style="text-align: center; color: var(--color-text-muted);">{{ 'cart.empty' | t | default: 'Your bag is empty.' }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
